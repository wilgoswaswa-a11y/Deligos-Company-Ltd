# Local MySQL settings
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=pos_system

# Mail settings for password resets
# Prefer Brevo API keys over SMTP. Remove legacy SMTP vars from Railway if using Brevo API.
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_ADDRESS=no-reply@example.com
BREVO_FROM_NAME="POS System"
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="POS System"
MAIL_DEBUG=false

# Resend HTTP API (preferred in environments that block SMTP)
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_ADDRESS=no-reply@your-verified-domain.com
# RESEND_FROM_NAME="POS System"

# Railway or production MySQL URL support (optional)
# DATABASE_URL=mysql://root:password@host:port/dbname
# MYSQL_URL=mysql://root:password@host:port/dbname

# Lipana M-Pesa STK Push
# Create the secret key in the Lipana dashboard. Use sandbox while testing.
LIPANA_ENVIRONMENT=sandbox
LIPANA_SECRET_KEY=sk_test_replace_with_your_lipana_secret_key
# Optional: only use this to override the endpoint supplied by Lipana support.
# LIPANA_BASE_URL=https://api-sandbox.lipana.dev/v1
# LIPANA_PAYMENT_ENDPOINT=/stk-push
LIPANA_TIMEOUT=60
LIPANA_USE_MOCK=false
# Optional but recommended: lets Lipana confirm payments even if the cashier
# has not pressed Verify Payment yet. Configure this public URL in Lipana.
# LIPANA_WEBHOOK_URL=https://your-domain.example/lipana_webhook.php
# LIPANA_WEBHOOK_SECRET=replace_with_lipana_webhook_secret
