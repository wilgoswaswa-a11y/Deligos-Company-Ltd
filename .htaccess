Options -Indexes

# Require Apache's mod_headers. HSTS is emitted only for HTTPS requests, including
# deployments where a trusted reverse proxy terminates TLS.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://code.jquery.com https://cdnjs.cloudflare.com; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self'"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"
</IfModule>

<FilesMatch "(^\.env|^\.git|^composer\.(json|lock)$|^cookies\.txt$|^cli_response\.json$|^db_check\.json$|^test_sale\.json$|^response_raw\.txt$|^resp_verbose\.txt$|\.(sql|log|ini|bak|backup|old|dist)$)">
    Require all denied
</FilesMatch>
